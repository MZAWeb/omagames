# Maintainer: Daniel Dvorkin <daniel@mzaweb.com>

pkgname=oma2048
pkgver=0.1.0
pkgrel=1
pkgdesc='2048 for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/MZAWeb/omagames'
license=('MIT' 'OFL-1.1')
install='oma2048.install'
options=('!debug')
depends=('hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/../../.."
  ./bin/build oma2048
}

package() {
  cd "$startdir/../../.."
  /usr/bin/install -Dm755 build/games/oma2048/oma2048 "$pkgdir/usr/bin/oma2048"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 common/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/oma2048.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/oma2048.svg"
  /usr/bin/install -Dm644 "$startdir/oma2048.desktop" "$pkgdir/usr/share/applications/oma2048.desktop"
}
