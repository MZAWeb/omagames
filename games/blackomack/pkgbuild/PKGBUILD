# Maintainer: Daniel Dvorkin <daniel@mzaweb.com>

pkgname=blackomack
pkgver=0.1.0
pkgrel=1
pkgdesc='Blackjack for Omarchy'
arch=('x86_64')
url='https://github.com/danieldvorkin/omagames'
license=('MIT')
install='blackomack.install'
depends=('qt6-base' 'qt6-declarative')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/../../.."
  ./bin/build blackomack
}

package() {
  cd "$startdir/../../.."
  /usr/bin/install -Dm755 build/games/blackomack/blackomack "$pkgdir/usr/bin/blackomack"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 common/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/blackomack.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/blackomack.svg"
  /usr/bin/install -Dm644 "$startdir/blackomack.desktop" "$pkgdir/usr/share/applications/blackomack.desktop"
}
