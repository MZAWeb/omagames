#!/usr/bin/env sh
# Run the QtTest suites headlessly (all of them, or one: bin/test omadoku).
# `common` is a suite like any game: its tests live in common/tests/.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
if command -v qmake6 >/dev/null 2>&1; then QMAKE=qmake6; else QMAKE=qmake; fi
JOBS="$(nproc 2>/dev/null || echo 1)"
if [ $# -ge 1 ]; then SUITES="$1"; else SUITES="common $(ls "$ROOT/games")"; fi
STATUS=0
for SUITE in $SUITES; do
  if [ -d "$ROOT/games/$SUITE" ]; then SRC="$ROOT/games/$SUITE"; else SRC="$ROOT/$SUITE"; fi
  [ -f "$SRC/tests/tests.pro" ] || { echo "== $SUITE: no tests"; continue; }
  BUILD_DIR="$ROOT/build-tests/$SUITE"
  mkdir -p "$BUILD_DIR" && cd "$BUILD_DIR"
  "$QMAKE" "$SRC/tests/tests.pro" && make -j"$JOBS"
  echo "== $SUITE"
  QT_QPA_PLATFORM=offscreen "./tst_$SUITE" || STATUS=1
done
exit $STATUS
