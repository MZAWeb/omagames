#!/usr/bin/env sh
# Build and install one game's Arch package: bin/install omadoku
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
GAMES="$(ls "$ROOT/games" | tr '\n' ' ')"
GAME="${1:-}"
if [ -z "$GAME" ] || [ ! -d "$ROOT/games/$GAME" ]; then
  echo "usage: bin/install <game>" >&2
  echo "games: $GAMES" >&2
  exit 1
fi
shift
command -v makepkg >/dev/null 2>&1 || { echo "makepkg is required." >&2; exit 1; }
"$ROOT/bin/build" "$GAME"
cd "$ROOT/games/$GAME/pkgbuild"
exec makepkg -fsi "$@"
